#!/bin/sh /etc/rc.common
# Factory reset from the RESET button.  See /usr/sbin/hh71vm-reset-button for why
# this polls a GPIO instead of using gpio-keys, and for the pin evidence.

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/hh71vm-reset-button

start_service() {
	# Installed but not executable is a packaging defect, not a configuration.  It
	# must never pass silently: the only symptom would be a reset button that does
	# nothing, discovered by a user who is already locked out of the router.
	if [ ! -x "$PROG" ]; then
		logger -s -t hh71vm-reset-button -p daemon.err \
			"$PROG is not executable, the reset button will not work (chmod +x to recover)"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
