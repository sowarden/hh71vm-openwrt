#!/bin/sh
# The set of captured interfaces is "everything except the way out", so it changes when
# the way out does: the modem coming back, or a cable making the combined port the WAN.
# Recompute and reinstall on those events. `restore` is a no-op unless the connection is
# meant to be up and the mode is vpn, so this costs nothing when Xray is not in use.

[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ] || exit 0

# Debounce: several interfaces come up at once at boot, and each one would otherwise
# rebuild the whole rule set.
LOCK=/var/run/xray-hotplug.stamp
now=$(cut -d. -f1 /proc/uptime)
if [ -f "$LOCK" ]; then
	last=$(cat "$LOCK" 2>/dev/null || echo 0)
	[ $((now - last)) -lt 5 ] && exit 0
fi
echo "$now" > "$LOCK"

/usr/sbin/hh71vm-xray-fw restore >/dev/null 2>&1
exit 0
