#!/usr/bin/lua
--[[
The "reconnect automatically if the connection drops" half of the page.

procd already restarts Xray if the process dies.  This covers the case procd cannot
see: the process is alive, the port is open, and nothing gets through -- the server
went away, the address moved, the modem reconnected with a new session, or the tunnel
is simply wedged.

It probes through the router's own HTTP inbound on a timer.  After `watchdog_fails`
failures in a row it regenerates the configuration (which resolves the server name
again -- a moved address is the common case), re-applies the firewall rules and kills
the Xray process.  It does not call `/etc/init.d/xray restart`: this runs as a second
instance of that same service, and restarting the service would kill this process in
the middle of doing it.  procd respawns the one that was killed.
]]

package.path = "/usr/lib/lua/?.lua;" .. package.path

local nixio = require "nixio"
local json  = require "luci.jsonc"
local X = require "hh71vm.xray"

local STATEFILE = "/var/run/xray.watchdog.json"
local UCI_FILE  = "/etc/config/xray"

local function log(msg)
	os.execute("/usr/bin/logger -t xray-watchdog " .. X.shq(msg))
end

local function sleep(sec)
	nixio.nanosleep(math.floor(sec), 0)
end

--- Merge a few fields into the state file instead of overwriting it, so a memory
--- guard event does not erase the last_reconnect/reconnects fields the page may show,
--- and vice versa.
local function write_state(patch)
	local cur = {}
	local raw = X.readfile(STATEFILE)
	if raw then
		local t = json.parse(raw)
		if type(t) == "table" then cur = t end
	end
	for k, v in pairs(patch) do cur[k] = v end
	X.writefile(STATEFILE, json.stringify(cur) .. "\n")
end

-- Forking `sh` and `uci` on every tick to read settings this loop already knows have
-- not changed is wasted work on a CPU that also has to run Xray. The config file's
-- own mtime is one cheap stat() away, so the expensive read only happens when it
-- actually moved.
local settings_cache, settings_mtime = nil, nil
local function get_settings()
	local mtime = nixio.fs.stat(UCI_FILE, "mtime")
	if settings_cache and mtime and mtime == settings_mtime then
		return settings_cache
	end
	settings_cache = X.settings()
	settings_mtime = mtime
	return settings_cache
end

--- /var/log/xray.log lives on tmpfs and nothing else ever rotates it.  Truncated in
--- place (not unlinked) because Xray keeps the file open for the life of the process.
local function check_logfile(s)
	local max_kb = X.isnum(s.logfile_max_kb, 0, 1000000)
	if max_kb == nil then max_kb = 256 end
	if max_kb == 0 then return end
	local size = nixio.fs.stat(X.LOGFILE, "size")
	if size and size > max_kb * 1024 then
		X.truncate_file(X.LOGFILE)
		log(("truncated the error log (%d bytes, over the %d KiB limit)")
		    :format(size, max_kb))
	end
end

local fails = 0
local recoveries = 0
local last_pid = nil
local down = false
local mem_fails = 0
local mem_guard_fired = 0

-- Xray needs about ten seconds to come up on this CPU, and procd starts this instance
-- at the same moment as that one.  Without a settling period the first probe lands
-- before the tunnel exists, the watchdog decides the connection is broken and kills a
-- process that was still starting -- which is exactly what it did the first time it
-- ran.  One period is waited after every start, including a restart it caused itself.
local function settle(period)
	sleep(math.max(period, 30))
end

log("started")

while true do
	local s = get_settings()
	local period = X.isnum(s.watchdog_period, 10, 3600) or 60
	local limit  = X.isnum(s.watchdog_fails, 1, 20) or 2
	local mem_guard_mb = X.isnum(s.mem_guard_mb, 0, 8192)
	if mem_guard_mb == nil then mem_guard_mb = 96 end
	local mem_guard_limit = X.isnum(s.mem_guard_fails, 1, 20) or 3

	if not X.bool(s.watchdog) or not X.bool(s.enabled) then
		fails = 0
		mem_fails = 0
		sleep(period)
	else
		check_logfile(s)

		local pid = X.pid()
		if not pid then
			-- procd's own business; wait for it rather than fighting over the pid
			last_pid = nil
			mem_fails = 0
			sleep(math.min(period, 15))
		elseif pid ~= last_pid then
			last_pid = pid
			fails = 0
			mem_fails = 0
			settle(period)
		else
			-- The RSS guard is independent of the probe: a tunnel that still answers
			-- perfectly well is exactly the case the reality leak produces, since it
			-- is peers going silent - not this end failing - that leave connections
			-- open. Checked every tick regardless of what the probe says.
			local recycled = false
			if mem_guard_mb > 0 then
				local rss = X.rss_bytes(pid)
				if rss and rss > mem_guard_mb * 1024 * 1024 then
					mem_fails = mem_fails + 1
					log(("RSS %d MiB over the %d MiB guard (%d/%d)"):format(
						math.floor(rss / (1024 * 1024)), mem_guard_mb,
						mem_fails, mem_guard_limit))
					if mem_fails >= mem_guard_limit then
						mem_guard_fired = mem_guard_fired + 1
						log(("recycling: RSS stayed over %d MiB for %d checks")
						    :format(mem_guard_mb, mem_fails))
						nixio.kill(pid, 15)
						write_state({ mem_guard_last = os.time(),
						              mem_guard_fired = mem_guard_fired })
						mem_fails = 0
						recycled = true
					end
				else
					mem_fails = 0
				end
			end

			if recycled then
				sleep(15)
			else
				local pr = X.probe(s)
				if pr.ok then
					-- `fails` is reset by a reconnect, so it cannot be what decides
					-- whether to say the connection came back: without a separate
					-- flag the recovery is silent and the log ends on the last
					-- failure.
					if down then
						log("connection restored after " .. recoveries .. " reconnect(s)")
						down = false
					end
					fails = 0
					if X.bool(s.set_clock) and pr.date then X.sync_clock(pr.date) end
				else
					fails = fails + 1
					down = true
					log(("probe failed (%d/%d): %s"):format(fails, limit,
					    tostring(pr.error or "no answer")))
					if fails >= limit then
						recoveries = recoveries + 1
						log("reconnecting")
						local meta, err = X.generate({ tproxy = X.tproxy_available() })
						if not meta then
							log("cannot regenerate the configuration: " .. tostring(err))
						else
							if s.mode == "vpn" then
								os.execute("/usr/sbin/hh71vm-xray-fw up >/dev/null 2>&1")
							end
							nixio.kill(pid, 15)
						end
						fails = 0
						write_state({ last_reconnect = os.time(), reconnects = recoveries })
						sleep(15)
					end
				end
				sleep(period)
			end
		end
	end
end
