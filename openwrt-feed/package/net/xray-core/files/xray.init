#!/bin/sh /etc/rc.common
# Xray. START is 96 so hh71vm-extern (94) has already tried to mount the share the
# binary lives on; hh71vm-xray waits for it anyway, because that mount retries in the
# background and can finish later.
#
# Two settings decide what happens here and they are deliberately not the same one:
#
#   enabled    the connection is meant to be up now.  The Connect and Disconnect
#              buttons set it.
#   autostart  the connection is meant to come up when the router is powered on.
#              Only boot() reads it -- so "connect now" and "connect at every boot"
#              stay independent, which is what the two checkboxes on the page mean.

START=96
STOP=10

USE_PROCD=1
PROG=/usr/sbin/hh71vm-xray

start_service() {
	config_load xray
	local enabled mode wd gogc gomemlimit_mb
	config_get_bool enabled main enabled 0
	config_get mode main mode vpn
	config_get_bool wd main watchdog 0
	config_get gogc main gogc 50
	config_get gomemlimit_mb main gomemlimit_mb 80
	[ "$enabled" = 1 ] || return 0

	# Regenerate before starting: the server address is resolved again here, which is
	# what makes a reboot or a modem reconnect survivable.  A failure leaves the last
	# working configuration in place on purpose.
	/usr/sbin/hh71vm-xrayctl generate >/dev/null 2>&1

	# The error log lives on tmpfs and is never rotated on its own. Truncating it here
	# keeps a long-running connection from slowly filling RAM with its own log, without
	# touching the file Xray is about to open for the first time - `>` creates it if it
	# is missing and never errors for that.
	: > /var/log/xray.log 2>/dev/null

	procd_open_instance xray
	procd_set_param command "$PROG" run
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/xray.pid
	# Unlimited retries with a long threshold: the usual reason for an early exit is
	# that the share is not up yet, and that fixes itself.
	procd_set_param respawn 3600 10 0
	# 1024 open files is generous for a proxy that opens a handful of listening
	# sockets and whatever connections are actually in flight; it exists to catch a
	# leak turning into an fd exhaustion crash instead of a slow RSS climb nobody
	# notices until uhttpd starts failing to fork.
	procd_set_param limits nofile="1024 4096"
	# GOGC lower than Go's default 100 trades some CPU for collecting sooner, and
	# GOMEMLIMIT gives the runtime a soft ceiling to collect against instead of only
	# ever reacting to GOGC on a board with no swap to fall back on. Either is left
	# unset (Go's own default applies) when the matching option is "0". Both env
	# vars have to go through one procd_set_param call: a second call for the same
	# param name replaces the first instead of adding to it.
	local envs=""
	[ "$gogc" != "0" ] && envs="$envs GOGC=$gogc"
	[ "$gomemlimit_mb" != "0" ] && envs="$envs GOMEMLIMIT=${gomemlimit_mb}MiB"
	[ -n "$envs" ] && procd_set_param env $envs
	procd_close_instance

	if [ "$mode" = "vpn" ]; then
		# Not installed directly here: the process instance above has only just
		# been told to start, and on this board it can legitimately take up to
		# a couple of minutes (the /mnt/extern share, then Xray's own startup)
		# before it actually opens a port. Redirecting the LAN into a tunnel
		# that is not listening yet breaks its DNS and TCP outright instead of
		# leaving it working unproxied -- see hh71vm-xray-fw arm, which waits
		# for the redirect port and installs the rules the moment it is real,
		# and gives up quietly, installing nothing, if it never is.
		procd_open_instance fwarm
		procd_set_param command /usr/sbin/hh71vm-xray-fw arm
		procd_close_instance
	fi

	if [ "$wd" = 1 ]; then
		procd_open_instance watchdog
		procd_set_param command /usr/sbin/hh71vm-xray-watchdog
		procd_set_param respawn 3600 10 0
		procd_close_instance
	fi
}

stop_service() {
	/usr/sbin/hh71vm-xray-fw down >/dev/null 2>&1
}

boot() {
	config_load xray
	local autostart enabled
	config_get_bool autostart main autostart 0
	if [ "$autostart" != 1 ]; then
		# `enabled` ("meant to be up now") is a UCI setting and survives every
		# reboot, so it can still read 1 from a session before this power
		# cycle even though nothing on this boot is going to start Xray. That
		# alone used to be enough for the firewall include to install the
		# capture rules for a tunnel that was never coming up this boot,
		# breaking the LAN's DNS and TCP (see hh71vm-xray-fw's restore, fixed
		# separately). Correct the record instead of starting the service:
		# the router was not asked to connect at boot.
		config_get_bool enabled main enabled 0
		if [ "$enabled" = 1 ]; then
			uci -q set xray.main.enabled=0
			uci -q commit xray
		fi
		return 0
	fi
	uci -q set xray.main.enabled=1
	uci -q commit xray
	start "$@"
}

service_triggers() {
	procd_add_reload_trigger xray
}

reload_service() {
	restart
}
