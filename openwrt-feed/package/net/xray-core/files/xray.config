# Xray service settings.  The servers themselves live in /etc/xray/profiles.json, which
# the page writes; this file holds only what the service and the firewall need, because
# both are shell and neither can parse JSON.
#
# 'binary' is normally left empty. Empty means: look on the /mnt/extern share first
# (where `hh71vm-extern-pkg install xray-core` puts it), then /usr/bin/xray.

config xray 'main'
	# the connection is meant to be up now (the Connect / Disconnect buttons)
	option enabled '0'
	# bring it up when the router is powered on
	option autostart '0'
	# probe the tunnel on a timer and reconnect when it stops carrying traffic
	option watchdog '0'
	option watchdog_period '60'
	option watchdog_fails '2'

	# vpn:   the LAN's traffic and the router's own are redirected into Xray with
	#        netfilter, so nothing has to be configured on any client.
	# proxy: Xray only listens on the SOCKS and HTTP ports and clients point at it.
	option mode 'vpn'

	option binary ''
	option config '/etc/xray/config.json'
	# geoip.dat / geosite.dat live here. They are not shipped: together they are
	# larger than the whole rootfs partition. Rules that name geoip: or geosite:
	# fail without them.
	option assets '/mnt/extern/xray'
	# How long the launcher waits for the share to come up before giving up and
	# letting procd respawn it.
	option wait '120'

	# local ports.  socks and http exist in both modes; the other three are the
	# transparent inbounds and are only listened on in vpn mode.
	option socks_port '1080'
	option http_port '1081'
	option redirect_port '1082'
	option tproxy_port '1083'
	option dns_port '1053'
	# where redirected DNS queries are really sent, through the tunnel
	option dns_server '1.1.1.1'

	# Which interfaces carry the clients whose traffic is captured.  Empty means
	# "work it out": every interface with an address except the one the default route
	# leaves by.  On this board that is br-lan, which carries the LAN ports and both
	# Wi-Fi radios.  Set a space separated list to override it.
	option lan_ifaces ''
	# capture what the router itself starts, as well as what it forwards
	option router_traffic '1'
	# Capture UDP as well, through TPROXY.  Off by default and not because the
	# module is missing: on this board Xray reads the captured packet, tunnels it and
	# never writes the answer back, so the traffic disappears instead of going out
	# unproxied.  Measured 2026-09-04.  Leave it off unless you are testing it.
	option capture_udp '0'
	# While UDP is not captured, rejecting QUIC makes browsers fall back to TCP
	# instead of leaving unproxied.
	option block_quic '1'
	# there is no IPv6 tunnel, so IPv6 must not have a way out either
	option block_ipv6 '1'
	option sniffing '1'
	option loglevel 'warning'

	# how the page decides whether the tunnel really carries traffic
	option probe_url 'http://cp.cloudflare.com/generate_204'
	option probe_timeout '12'
	# set the clock from the probe answer.  This board has no working NTP and VMess
	# refuses to connect when the clock is more than 90 s out, blaming the user id.
	option set_clock '1'

	# the socket mark Xray's own connections carry, so the redirect rules can let
	# them through instead of feeding the tunnel to itself
	option fwmark '255'
	option tproxy_mark '1'
	option tproxy_table '100'

	# a small HTTP API for automation: off until it is switched on, and then it needs
	# the token below on every request
	option api_enabled '0'
	option api_token ''
